# OPENAI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# CORS_ORIGINS=

# Web (Vercel) — see web/.env.example
# VITE_CONVEX_URL=
# VITE_API_URL=
